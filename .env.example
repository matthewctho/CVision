# Copy to .env.local and fill in your own values. Never commit real keys.

# Transport for NSW Open Data – car park occupancy (https://opendata.transport.nsw.gov.au)
TRANSPORT_NSW_KEY=

# Google Maps Platform – geocoding, Places and routing
GOOGLE_MAPS_API_KEY=

# Google Gemini – AI car park safety scoring (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google OAuth 2.0 Web client – sign-in + Google Calendar
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# CARTO basemap tiles (optional, https://carto.com/basemaps)
NEXT_PUBLIC_CARTO_API_KEY=

# Long random string used to sign session cookies, e.g. `openssl rand -base64 32`
AUTH_SECRET=
